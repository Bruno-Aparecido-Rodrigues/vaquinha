{
  "expo": {
    "name": "Muuv Vaquinhas",
    "slug": "muuv-vaquinhas",
    "scheme": "muuv",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "router": {
      "root": "src/app"
    }
  }
}
